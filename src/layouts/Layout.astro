---
const { title = "Max Burkhardt — Portfolio" } = Astro.props;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>

    <style>
      :root {
        --bg: #f0ece4;
        --card: #ffffff;
        --card-hover: #fff7cc;
        --text: #000000;
        --muted: #444444;
        --border: #000000;
        --link: #000000;
        --link-hover: #000000;
        --accent: #ffde00;
        --accent-soft: rgba(255, 222, 0, 0.3);
      }

      [data-theme="dark"] {
        --bg: #111111;
        --card: #1c1c1c;
        --card-hover: #2a2a2a;
        --text: #f0ece4;
        --muted: #999999;
        --border: #f0ece4;
        --link: #ffde00;
        --link-hover: #ffe940;
        --accent: #ffde00;
        --accent-soft: rgba(255, 222, 0, 0.15);
      }

      [data-theme="light"] {
        --bg: #f0ece4;
        --card: #ffffff;
        --card-hover: #fff7cc;
        --text: #000000;
        --muted: #444444;
        --border: #000000;
        --link: #000000;
        --link-hover: #000000;
        --accent: #ffde00;
        --accent-soft: rgba(255, 222, 0, 0.3);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        border-radius: 0 !important;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      h1, h2, h3, h4 {
        font-weight: 900;
        color: var(--text);
      }


      .bg-texture {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: -1;

        background-image: url("/paper-texture.png");
        background-repeat: repeat;
        background-size: 512px 512px;
        opacity: 0.04;
      }

      main {
        max-width: 100%;
        margin: 0 auto;
        min-height: calc(100vh - 200px);
        flex: 1;
      }

      a {
        color: var(--link);
      }

      a:visited {
        color: var(--link);
      }

      a:hover {
        color: var(--link-hover);
      }

      header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: var(--bg);
        border-bottom: 2px solid var(--border);
      }

      .header-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0.75rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1.5rem;
      }

      .logo {
        font-weight: 900;
        color: var(--text);
        text-decoration: none;
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
      }

      .logo:hover {
        color: var(--text);
        text-decoration: none;
      }

      .logo-name {
        font-size: 1.1rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .logo-title {
        font-size: 0.7rem;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-weight: 700;
      }

      .nav-content {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      nav {
        display: flex;
        gap: 0.4rem;
        margin-right: 0.5rem;
      }

      nav a {
        font-size: 0.78rem;
        font-weight: 700;
        padding: 0.3rem 0.65rem;
        text-decoration: none;
        color: var(--text);
        border: 2px solid transparent;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        transition: background 0.08s ease, border-color 0.08s ease;
      }

      nav a:hover {
        color: #000;
        background: var(--accent);
        border-color: var(--border);
        text-decoration: none;
      }

      nav a.active {
        color: #000;
        background: var(--accent);
        border: 2px solid var(--border);
        box-shadow: 2px 2px 0 var(--border);
      }

      .primary-button,
      .icon-button {
        padding: 0.4rem 1.1rem;
        font-size: 0.78rem;
        font-weight: 700;
        text-decoration: none;
        border: 2px solid var(--border);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        cursor: pointer;
        white-space: nowrap;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        box-shadow: 3px 3px 0 var(--border);
        transition: box-shadow 0.08s ease, transform 0.08s ease;
      }

      .primary-button {
        background: var(--accent);
        color: #000;
      }

      .primary-button:visited {
        color: #000;
      }

      .primary-button:hover {
        background: var(--accent);
        color: #000;
        box-shadow: 1px 1px 0 var(--border);
        transform: translate(2px, 2px);
        text-decoration: none;
      }

      .icon-button {
        background: var(--card);
        color: var(--text);
      }

      .icon-button:visited {
        color: var(--text);
      }

      .icon-button:hover {
        background: var(--accent);
        color: #000;
        box-shadow: 1px 1px 0 var(--border);
        transform: translate(2px, 2px);
        text-decoration: none;
      }

      .theme-toggle {
        width: 2.1rem;
        height: 2.1rem;
        border: 2px solid var(--border);
        background: var(--card);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: var(--text);
        font-size: 0.95rem;
        box-shadow: 3px 3px 0 var(--border);
        transition: box-shadow 0.08s ease, transform 0.08s ease;
      }

      .theme-toggle:hover {
        background: var(--accent);
        color: #000;
        box-shadow: 1px 1px 0 var(--border);
        transform: translate(2px, 2px);
      }

      .prose {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem 3.5rem;
      }

      /* Code blocks inside markdown */
      .prose pre {
        max-width: 100%;
        overflow-x: auto;
        border: 2px solid var(--border);
        box-shadow: 4px 4px 0 var(--border);
      }

      @media (max-width: 768px) {
        .header-container {
          padding-inline: 1.25rem;
        }

        nav {
          display: none;
        }
      }
    </style>

    <script>
      declare global {
        interface Window {
          __toggleTheme: () => void;
        }
      }

      (() => {
        const stored = window.localStorage.getItem("theme");
        const prefersDark =
          window.matchMedia &&
          window.matchMedia("(prefers-color-scheme: dark)").matches;
        const initial = stored || (prefersDark ? "dark" : "light");

        document.documentElement.setAttribute("data-theme", initial);

        window.__toggleTheme = () => {
          const current =
            document.documentElement.getAttribute("data-theme") || "dark";
          const next = current === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", next);
          window.localStorage.setItem("theme", next);
          const icon = document.querySelector("[data-theme-icon]");
          if (icon) icon.textContent = next === "dark" ? "☾" : "☼";
        };

        window.addEventListener("DOMContentLoaded", () => {
          const icon = document.querySelector("[data-theme-icon]");
          if (icon) {
            const current =
              document.documentElement.getAttribute("data-theme") || "dark";
            icon.textContent = current === "dark" ? "☾" : "☼";
          }
        });
      })();
    </script>
  </head>

  <body>
    <div class="bg-texture" aria-hidden="true"></div>
    <header>
      <div class="header-container">
        <a href="/" class="logo">
          <span class="logo-name">Max Burkhardt</span>
          <span class="logo-title">Gameplay Programmer</span>
        </a>

        <div class="nav-content">
          <nav>
            <a href="/" class={currentPath === "/" ? "active" : ""}>
              Projects
            </a>

            <a
              href="/design"
              class={currentPath.startsWith("/design") ? "active" : ""}
            >
              Concepts
            </a>

            <a
              href="/snippets"
              class={currentPath.startsWith("/snippets") ? "active" : ""}
            >
              Snippets
            </a>
          </nav>


          <a
            href="https://github.com/murkyperki"
            target="_blank"
            rel="noreferrer"
            class="icon-button"
          >
            GitHub
          </a>

          <a href="/CV_v9.pdf" target="_blank" class="primary-button">
            Resume ↓
          </a>

          <button class="theme-toggle" onclick="window.__toggleTheme()">
            <span data-theme-icon>☾</span>
          </button>
        </div>
      </div>
    </header>

<main>
  <div class="prose">
    <slot />
  </div>
</main>
  </body>
</html>