---
import Layout from "../../layouts/Layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props as { p: CollectionEntry<"projects"> };
const { Content } = await p.render();
---

<Layout title={`${p.data.title} — Max Burkhardt`}>

  <!-- ── Back link ── -->
  <nav class="project-nav">
    <a href="/" class="back-link">← All Projects</a>
  </nav>

  <!-- ── Hero ── -->
  <div class="project-hero">
    <div class="project-hero-inner">
      <h1 class="project-title">{p.data.title}</h1>
      {p.data.role && <p class="project-subtitle">{p.data.role}</p>}
      {p.data.highlights && p.data.highlights.length > 0 && (
        <div class="project-tags">
          {p.data.highlights.map((h: string) => (
            <span class="project-tag">{h}</span>
          ))}
        </div>
      )}
    </div>
  </div>

  <!-- ── Lead paragraph (pitch) ── -->
  {p.data.pitch && (
    <div class="project-lead">
      <p class="project-lead-text">{p.data.pitch}</p>
    </div>
  )}

  <!-- ── Two-column body ── -->
  <div class="project-body-grid">

    <!-- Left: gallery → writeup -->
    <div class="project-main">

      {(p.data.gallery && p.data.gallery.length > 0) || p.data.hasGalleryPlaceholder ? (
        <section class="project-gallery">
          {p.data.gallery && p.data.gallery.length > 0 ? (
            p.data.gallery.map((item) => {
              if (typeof item === 'string') {
                return <img src={item} alt="" class="gallery-media" />;
              }
              const { src, type, alt, caption, poster } = item;
              return (
                <figure class="gallery-figure">
                  {type === 'video' ? (
                    <video src={src} poster={poster} autoplay muted loop playsinline class="gallery-media">
                      Your browser doesn't support video.
                    </video>
                  ) : (
                    <img src={src} alt={alt || ''} class="gallery-media" />
                  )}
                  {caption && <figcaption class="gallery-caption">{caption}</figcaption>}
                </figure>
              );
            })
          ) : (
            <div class="gallery-placeholder">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
              <p>Media coming soon</p>
            </div>
          )}
        </section>
      ) : null}

      <section class="project-writeup">
        <h2 class="col-heading">What I Built</h2>
        <div class="prose">
          <Content />
        </div>
      </section>

    </div>

    <!-- Right: sticky sidebar -->
    <aside class="project-sidebar">

      {p.data.role && (
        <div class="sidebar-block">
          <p class="sidebar-label">Role</p>
          <p class="sidebar-value">{p.data.role}</p>
        </div>
      )}

      {p.data.pitch && (
        <div class="sidebar-block">
          <p class="sidebar-label">Summary</p>
          <p class="sidebar-value">{p.data.pitch}</p>
        </div>
      )}

      {((p.data.links && p.data.links.length > 0) || (p.data.media && p.data.media.length > 0)) && (
        <div class="sidebar-block">
          <p class="sidebar-label">Links</p>
          <div class="sidebar-links">
            {p.data.links && p.data.links.map((l: { label: string; href: string }) => (
              <a class="sidebar-link" href={l.href} target="_blank" rel="noreferrer">{l.label} ↗</a>
            ))}
            {p.data.media && p.data.media.map((m: { label: string; href: string }) => (
              <a class="sidebar-link" href={m.href} target="_blank" rel="noreferrer">{m.label} ↗</a>
            ))}
          </div>
        </div>
      )}

    </aside>
  </div>

  <!-- ── Lessons Learned callout ── -->
  {p.data.lessons && p.data.lessons.length > 0 && (
    <div class="lessons-callout">
      <div class="lessons-inner">
        <h2 class="col-heading">Lessons Learned</h2>
        <ul class="lessons-list">
          {p.data.lessons.map((l: string) => <li>{l}</li>)}
        </ul>
      </div>
    </div>
  )}

  <style>
    /* ─── Back link nav ─── */
    .project-nav {
      max-width: 1100px;
      margin: 0 auto;
      padding: 1.5rem 2rem 0;
    }

    .back-link {
      display: inline-block;
      font-weight: 700;
      text-decoration: none;
      color: var(--text);
      background: var(--card);
      border: 2px solid var(--border);
      padding: 0.35rem 0.9rem;
      box-shadow: 3px 3px 0 var(--border);
      text-transform: uppercase;
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      transition: box-shadow 0.08s ease, transform 0.08s ease, background 0.08s ease;
    }

    .back-link:hover {
      box-shadow: 1px 1px 0 var(--border);
      transform: translate(2px, 2px);
      background: var(--accent);
      color: #000;
      text-decoration: none;
    }

    /* ─── Hero ─── */
    .project-hero {
      margin-top: 1.5rem;
      border-top: 2px solid var(--border);
      border-bottom: 2px solid var(--border);
    }

    .project-hero-inner {
      max-width: 1100px;
      margin: 0 auto;
      padding: 2.5rem 2rem 2.25rem;
    }

    .project-title {
      font-size: clamp(2.25rem, 5.5vw, 4rem);
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: -0.01em;
      line-height: 1;
      color: var(--text);
    }

    .project-subtitle {
      font-size: 0.88rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--muted);
      margin-top: 0.65rem;
    }

    .project-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 1.25rem;
    }

    .project-tag {
      display: inline-block;
      padding: 0.25rem 0.7rem;
      border: 2px solid var(--border);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.03em;
      color: #000;
      background: var(--accent);
    }

    /* ─── Lead / pitch ─── */
    .project-lead {
      max-width: 1100px;
      margin: 1.75rem auto 0;
      padding: 0 2rem;
    }

    .project-lead-text {
      border-left: 3px solid var(--border);
      padding-left: 1rem;
      font-size: 0.98rem;
      line-height: 1.7;
      color: var(--muted);
      max-width: 680px;
    }

    /* ─── Two-column grid ─── */
    .project-body-grid {
      max-width: 1100px;
      margin: 2rem auto 0;
      padding: 0 2rem;
      display: grid;
      grid-template-columns: minmax(0, 1.85fr) minmax(0, 1fr);
      gap: 2.5rem;
      align-items: start;
    }

    /* Left column */
    .project-main {
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
      min-width: 0;
    }

    /* Gallery */
    .project-gallery {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .gallery-media {
      width: 100%;
      display: block;
      border: 2px solid var(--border);
      box-shadow: 4px 4px 0 var(--border);
    }

    .gallery-figure {
      margin: 0;
    }

    .gallery-caption {
      font-size: 0.78rem;
      color: var(--muted);
      margin-top: 0.4rem;
      padding-left: 0.25rem;
    }

    .gallery-placeholder {
      aspect-ratio: 16 / 9;
      background: var(--card);
      border: 2px dashed var(--border);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      color: var(--muted);
    }

    .gallery-placeholder svg {
      opacity: 0.4;
    }

    .gallery-placeholder p {
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin: 0;
    }

    /* Writeup */
    .project-writeup {
      min-width: 0;
    }

    /* Shared column heading label style */
    .col-heading {
      font-size: 0.72rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--muted);
      padding-bottom: 0.5rem;
      margin-bottom: 1.25rem;
      border-bottom: 2px solid var(--border);
    }

    /* ─── Sidebar ─── */
    .project-sidebar {
      position: sticky;
      top: 4.5rem;
      border: 2px solid var(--border);
      box-shadow: 4px 4px 0 var(--border);
      background: var(--card);
      overflow: hidden;
    }

    .sidebar-block {
      padding: 1rem 1.25rem;
      border-bottom: 2px solid var(--border);
    }

    .sidebar-block:last-child {
      border-bottom: none;
    }

    .sidebar-label {
      font-size: 0.62rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--muted);
      margin-bottom: 0.35rem;
    }

    .sidebar-value {
      font-size: 0.875rem;
      line-height: 1.55;
      color: var(--text);
      font-weight: 500;
    }

    .sidebar-links {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .sidebar-link {
      display: block;
      padding: 0.45rem 0.75rem;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      text-decoration: none;
      color: var(--text);
      border: 2px solid var(--border);
      box-shadow: 3px 3px 0 var(--border);
      background: var(--bg);
      transition: transform 0.08s ease, box-shadow 0.08s ease, background 0.08s ease;
    }

    .sidebar-link:hover {
      transform: translate(-2px, -2px);
      box-shadow: 5px 5px 0 var(--border);
      background: var(--accent);
      color: #000;
      text-decoration: none;
    }

    /* ─── Lessons callout ─── */
    .lessons-callout {
      max-width: 1100px;
      margin: 3rem auto 0;
      padding: 0 2rem 3rem;
    }

    .lessons-inner {
      border: 2px solid var(--border);
      border-top: 4px solid var(--accent);
      box-shadow: 4px 4px 0 var(--border);
      padding: 1.5rem 1.75rem;
      background: var(--card);
    }

    .lessons-list {
      list-style: none;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }

    .lessons-list li {
      padding-left: 1.5rem;
      position: relative;
      font-size: 0.88rem;
      line-height: 1.65;
    }

    .lessons-list li::before {
      content: "→";
      position: absolute;
      left: 0;
      font-weight: 900;
    }

    /* ─── Prose (markdown body) ─── */
    .prose {
      font-size: 0.92rem;
      line-height: 1.75;
    }

    .prose :global(p) {
      margin-bottom: 1rem;
    }

    .prose :global(ul),
    .prose :global(ol) {
      margin-bottom: 1rem;
      padding-left: 1.5rem;
    }

    .prose :global(li) {
      margin-bottom: 0.4rem;
    }

    .prose :global(h2),
    .prose :global(h3) {
      font-size: 0.72rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--muted);
      margin-top: 1.75rem;
      margin-bottom: 0.75rem;
      padding-bottom: 0.4rem;
      border-bottom: 2px solid var(--border);
    }

    .prose :global(strong) {
      font-weight: 800;
    }

    .prose :global(code) {
      background: var(--bg);
      padding: 0.125rem 0.375rem;
      border: 1px solid var(--border);
      font-size: 0.875em;
    }

    /* ─── Responsive ─── */
    @media (max-width: 768px) {
      .project-body-grid {
        grid-template-columns: 1fr;
        gap: 2rem;
      }

      .project-sidebar {
        position: static;
      }

      .project-title {
        font-size: 2rem;
      }

      .project-nav,
      .project-lead,
      .project-body-grid,
      .lessons-callout {
        padding-left: 1.25rem;
        padding-right: 1.25rem;
      }
    }
  </style>
</Layout>
