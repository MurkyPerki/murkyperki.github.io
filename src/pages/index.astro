---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getCollection, type CollectionEntry } from "astro:content";

const projects: CollectionEntry<"projects">[] = await getCollection("projects");
---
<Layout title="Max Burkhardt — Portfolio">
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-headshot">
        <Image src="/MaxFull-mugshot.jpg" alt="Portrait of Max Burkhardt" width={150} height={150} />
      </div>
      <div class="hero-intro">
        <p>
         	Gameplay programmer interested in movement,
			boss design, and small systems that create clear and satisfying gameplay loops —
			and turning rough ideas into working prototypes.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Technical Experience</h2>
    <div class="tag-row">
      <span class="tag">C#</span>
      <span class="tag">Unity</span>
      <span class="tag">MonoGame</span>
      <span class="tag">JavaScript</span>
      <span class="tag">TypeScript</span>
      <span class="tag">Git</span>
      <span class="tag">Game AI</span>
      <span class="tag">Level Design</span>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Projects</h2>

    <div class="project-list">
      {projects.map((p) => (
        <a class="project-row" href={`/projects/${p.slug}/`}>
          <div class="project-media">
            {p.data.thumbnailVideo ? (
              <video
                src={p.data.thumbnailVideo.src}
                poster={p.data.thumbnailVideo.poster}
                class="project-media-video"
                autoplay
                muted
                loop
                playsinline
              />
            ) : (
              <div class="project-thumb">
                <span>{p.data.title}</span>
              </div>
            )}
          </div>

          <div class="project-body">
            <div class="project-heading">
              <h3>{p.data.title}</h3>
              {p.data.role && <p class="project-role">{p.data.role}</p>}
            </div>
            {p.data.pitch && (
              <p class="project-pitch">
                {p.data.pitch}
              </p>
            )}
            {p.data.highlights && p.data.highlights.length > 0 && (
              <div class="project-meta">
                {p.data.highlights.slice(0, 3).map((h) => (
                  <span class="meta-pill">{h}</span>
                ))}
              </div>
            )}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- About AT THE BOTTOM -->
  <section class="section section-alt">
    <div class="about">
      <h2>Hi, I'm Max</h2>
      <p>
        I’m a game development student at the HvA who enjoys building things that feel good to play. 
		I spend most of my time working on gameplay, AI behaviour, and level design 
		especially systems that react clearly and make sense to the player.
      </p>
      <p>
      	 I like breaking problems down, trying ideas fast, and polishing until movement, feedback, 
	  	 and flow click together. 
	     I also enjoy working with artists and designers (as an artist myself),
	  	 turning rough ideas into something that actually works in game.
      </p>
      <p>
        You can reach me by email or check out my GitHub.
        <a href="mailto:maxburkhardt@xs4all.nl">email</a> ,
        <a href="https://github.com/murkyperki" target="_blank" rel="noreferrer">GitHub</a>.
      </p>
    </div>
  </section>

  <style>
    .hero {
      max-width: 1100px;
      margin: 2.5rem auto 1.5rem;
      padding: 0 2rem;
    }
	  .hero-inner {
      display: grid;
      grid-template-columns: auto minmax(0, 1.4fr);
      gap: 2rem;
      align-items: center;
    }

	.hero-intro {
      background: var(--card);
      border: 2px solid var(--border);
      box-shadow: 4px 4px 0 var(--border);
      padding: 1.25rem 1.5rem;
      font-size: 0.95rem;
      color: var(--muted);
    }
	.hero-intro strong {
      color: var(--text);
      font-weight: 600;
    }

	  .hero-headshot {
      width: 150px;
      height: 150px;
      overflow: hidden;
      border: 2px solid var(--border);
      box-shadow: 4px 4px 0 var(--border);
      flex-shrink: 0;
      justify-self: start;
      margin-left: -0.75rem;
    }

	  .hero-headshot :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 60%;
      display: block;
      transform: scale(1.55) rotate(5deg);
    }

    .hero-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 2rem;
      margin-bottom: 1.75rem;
    }

    .hero-name {
      font-size: 2.75rem;
      font-weight: 800;
      letter-spacing: 0.02em;
    }

    .hero-title {
      margin-top: 0.25rem;
      font-size: 0.95rem;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: var(--muted);
    }

    .hero-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .primary-button,
    .icon-button {
      border-radius: 0;
      padding: 0.55rem 1.3rem;
      font-size: 0.8rem;
      font-weight: 600;
      text-decoration: none;
      border: 1px solid var(--border);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
      cursor: pointer;
      white-space: nowrap;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .primary-button {
      background: var(--accent);
      border-color: var(--accent);
      color: #1e2019;
    }

    .primary-button:hover {
      background: var(--link-hover);
      border-color: var(--link-hover);
    }

    .icon-button {
      background: transparent;
      color: var(--muted);
    }

    .icon-button:hover {
      color: var(--text);
      border-color: var(--muted);
    }

    .highlight-card {
      background: var(--card);
      border-radius: 6px;
      border: 1px solid var(--border);
      padding: 1.25rem 1.5rem;
      font-size: 0.95rem;
      color: var(--muted);
      max-width: 650px;
    }

    .highlight-card strong {
      color: var(--text);
      font-weight: 600;
    }

    .section {
      max-width: 1100px;
      margin: 0 auto;
      padding: 1.5rem 2rem 2.25rem;
    }

    .section-alt {
      background: var(--card);
      border-top: 2px solid var(--border);
      border-bottom: 2px solid var(--border);
      margin-top: 1.5rem;
      padding-top: 2.25rem;
      padding-bottom: 2.25rem;
    }

    .section-alt a {
      color: var(--link);
    }

    .section-title {
      font-size: 1.4rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 1.25rem;
    }

     .tag-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .tag {
      padding: 0.35rem 0.75rem;
      border: 2px solid var(--border);
      background: transparent;
      color: var(--text);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .about {
      max-width: 820px;
      margin: 0 auto;
    }

    .about h2 {
      font-size: 1.4rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 1rem;
    }

    .about p {
      font-size: 0.95rem;
      line-height: 1.7;
      margin-bottom: 0.9rem;
    }

          /* PROJECTS: 2‑column grid, simple “card” style like the reference */
    .project-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.75rem;
      padding-bottom: 3rem;
    }

   .project-row {
      display: flex;
      flex-direction: column;
      text-decoration: none;
      color: inherit;
      background: var(--card);
      border: 2px solid var(--border);
      box-shadow: 4px 4px 0 var(--border);
      overflow: hidden;
      transition: transform 0.08s ease, box-shadow 0.08s ease;
    }

    .project-row:hover {
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0 var(--border);
    }
    .project-media {
      position: relative;
      background: #000;
      overflow: hidden;
    }

	.project-media-video {
      width: 100%;
      display: block;
      object-fit: cover;
      aspect-ratio: 16 / 9;
    }

    .project-thumb {
      width: 100%;
      aspect-ratio: 16 / 9;
      display: flex;
      align-items: flex-end;
      justify-content: flex-start;
      padding: 0.75rem 1rem;
      background: var(--accent);
      border-bottom: 2px solid var(--border);
    }

    .project-thumb span {
      font-size: 0.85rem;
      font-weight: 800;
      color: #000;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .project-body {
      padding: 1.2rem 1.5rem 1.4rem;
      display: flex;
      color: var(--text);
      flex-direction: column;
      gap: 0.55rem;
    }

    .project-heading h3 {
      font-size: 1.05rem;
      font-weight: 900;
      margin-bottom: 0.1rem;
      color: var(--text);
      text-transform: uppercase;
      letter-spacing: 0.02em;
    }

    .project-row:hover .project-heading h3 {
      color: var(--text);
    }

    .project-role {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: var(--muted);
    }

    .project-pitch {
      font-size: 0.9rem;
      color: var(--text);
      opacity: 0.8;
    }

    .project-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-top: 0.4rem;
    }

    .meta-pill {
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.2rem 0.5rem;
      background: transparent;
      color: var(--text);
      border: 2px solid var(--border);
      letter-spacing: 0.03em;
      text-transform: uppercase;
    }

    @media (max-width: 900px) {
      .project-list {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 900px) {
      .hero {
        padding: 0 1.25rem;
      }

      .section {
        padding: 1.5rem 1.25rem 2rem;
      }

      .hero-header {
        flex-direction: column;
        align-items: flex-start;
      }

      .hero-actions {
        margin-top: 0.75rem;
      }

      .project-list {
        grid-template-columns: 1fr; /* 1 column on small screens */
      }
    }

    @media (max-width: 600px) {
      .hero-name {
        font-size: 2.1rem;
      }

      .hero-title {
        font-size: 0.85rem;
      }

      .primary-button,
      .icon-button